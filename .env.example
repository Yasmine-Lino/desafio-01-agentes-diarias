# Copie este arquivo para .env e configure sua propria chave.
# Nunca publique o arquivo .env no GitHub.
OPENAI_API_KEY=coloque_sua_chave_aqui

# Configuracoes protegidas fornecidas pelo servidor ao processo do Streamlit.
# Chave HMAC estavel de 32 bytes em hexadecimal.
BARREIRA_HMAC_CHAVE_HEX=
# Lista JSON de vinculos verificados com os campos iss, sub, matricula e protocolos.
TITULARES_OIDC_JSON=
